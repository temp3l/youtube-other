MEDIAFORGE_WORKSPACE=./episodes
MEDIAFORGE_DB_PATH=./.mediaforge.sqlite
# Local PostgreSQL Docker stack. These defaults are development-only.
MEDIAFORGE_POSTGRES_PORT=55433
MEDIAFORGE_POSTGRES_DATABASE=mediaforge
MEDIAFORGE_POSTGRES_INTEGRATION_DATABASE=mediaforge_integration
MEDIAFORGE_POSTGRES_ADMIN_USER=mediaforge_admin
MEDIAFORGE_POSTGRES_ADMIN_PASSWORD=mediaforge_admin_local
MEDIAFORGE_POSTGRES_APP_USER=mediaforge_app
MEDIAFORGE_POSTGRES_APP_PASSWORD=mediaforge_app_local
MEDIAFORGE_WORKFLOW_DATABASE_URL=postgresql://mediaforge_app:mediaforge_app_local@127.0.0.1:55433/mediaforge
POSTGRES_INTEGRATION_ADMIN_URL=postgresql://mediaforge_admin:mediaforge_admin_local@127.0.0.1:55433/mediaforge_integration
POSTGRES_INTEGRATION_APPLICATION_URL=postgresql://mediaforge_app:mediaforge_app_local@127.0.0.1:55433/mediaforge_integration
POSTGRES_INTEGRATION_APPLICATION_ROLE=mediaforge_app
MEDIAFORGE_RECONCILIATION_WORKSPACE_ID=workspace-local
# Durable webhook dispatcher settings. Signing secrets remain in an external secret store.
MEDIAFORGE_WEBHOOK_WORKSPACE_ID=workspace-local
MEDIAFORGE_WEBHOOK_WORKER_ID=webhook-local-1
MEDIAFORGE_WEBHOOK_POLL_INTERVAL_MS=1000
MEDIAFORGE_WEBHOOK_LEASE_SECONDS=60
# One-shot endpoint provisioning. The handle references an external secret; it is not the secret.
MEDIAFORGE_WEBHOOK_ENDPOINT_WORKSPACE_ID=workspace-local
MEDIAFORGE_WEBHOOK_ENDPOINT_ID=webhook-local
MEDIAFORGE_WEBHOOK_ENDPOINT_URL=https://hooks.example.invalid/mediaforge
MEDIAFORGE_WEBHOOK_ENDPOINT_SECRET_HANDLE=secretref://provider/webhooks/webhook-local/1
MEDIAFORGE_WEBHOOK_ENDPOINT_SECRET_VERSION=1
MEDIAFORGE_WEBHOOK_ENDPOINT_EVENT_FILTERS=workflow.succeeded,workflow.failed
# Authenticated API process. Configure real values before starting the role.
MEDIAFORGE_API_BIND_HOST=127.0.0.1
MEDIAFORGE_API_OIDC_ISSUER=
MEDIAFORGE_API_OIDC_AUDIENCE=
MEDIAFORGE_API_OIDC_JWKS_URL=
MEDIAFORGE_API_CURSOR_SECRET=
MEDIAFORGE_API_JWKS_CACHE_TTL_MS=300000
MEDIAFORGE_API_JWKS_TIMEOUT_MS=5000
# One-shot directory provisioning input for `pnpm api:provision-principal`.
MEDIAFORGE_PRINCIPAL_WORKSPACE_ID=workspace-local
MEDIAFORGE_PRINCIPAL_OIDC_SUBJECT=
MEDIAFORGE_PRINCIPAL_ID=
MEDIAFORGE_PRINCIPAL_KIND=user
MEDIAFORGE_PRINCIPAL_PERMISSIONS=content.read,content.write,workflow.start,workflow.cancel,validation.read,approval.decide
MEDIAFORGE_PRINCIPAL_ACTOR_SUBJECT=
# One-shot API-key issue/rotate/revoke input. New key material is printed only once.
MEDIAFORGE_API_KEY_ACTION=issue
MEDIAFORGE_API_KEY_WORKSPACE_ID=workspace-local
MEDIAFORGE_API_KEY_PRINCIPAL_ID=
MEDIAFORGE_API_KEY_PERMISSIONS=content.read,workflow.start
MEDIAFORGE_API_KEY_EXPIRES_AT=
MEDIAFORGE_API_KEY_ACTOR_SUBJECT=
MEDIAFORGE_API_KEY_ID=
MEDIAFORGE_API_KEY_PREVIOUS_ID=
MEDIAFORGE_API_KEY_EXPECTED_REVISION=
MEDIAFORGE_API_KEY_REVOCATION_REASON=
# Durable job role settings; an executable role also requires a canonical injected handler.
MEDIAFORGE_JOB_WORKSPACE_ID=workspace-local
MEDIAFORGE_JOB_POLL_INTERVAL_MS=1000
MEDIAFORGE_JOB_LEASE_SECONDS=60
MEDIAFORGE_JOB_MAX_ATTEMPTS=8
MEDIAFORGE_LOG_LEVEL=info
MEDIAFORGE_DEFAULT_ASPECT_RATIO=16:9
MEDIAFORGE_OPENART_BATCH_SIZE=8
MEDIAFORGE_TTS_PROVIDER=openai-compatible
MEDIAFORGE_TTS_VOICE_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
HISTORY_CHANNEL_VOICE_ID=9Ft9sm9dzvprPILZmLJl
ELEVENLABS_FEATURE_ENABLED=false
ELEVENLABS_REQUEST_TIMEOUT_MS=60000
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
MEDIAFORGE_TRANSCRIPTION_PROVIDER=mock
MEDIAFORGE_IMAGE_PROVIDER=mock
MEDIAFORGE_OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
MEDIAFORGE_OPENAI_COMPATIBLE_API_KEY=
MEDIAFORGE_OPENAI_COMPATIBLE_ORGANIZATION=
MEDIAFORGE_OPENAI_COMPATIBLE_PROJECT=
MEDIAFORGE_OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
MEDIAFORGE_OPENAI_COMPATIBLE_TTS_VOICE=onyx
MEDIAFORGE_OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
MEDIAFORGE_OPENAI_SPEECH_VOICE=onyx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
# Canonical text generation. Token values are ceilings, not targets.
MEDIAFORGE_OPENAI_STORY_MODEL=gpt-5.6-sol
MEDIAFORGE_OPENAI_STORY_REASONING_EFFORT=medium
MEDIAFORGE_OPENAI_STORY_MAX_OUTPUT_TOKENS=14000
MEDIAFORGE_OPENAI_STORY_RETRY_MAX_OUTPUT_TOKENS=14000
MEDIAFORGE_OPENAI_LOCALIZATION_MODEL=gpt-5.6-terra
MEDIAFORGE_OPENAI_LOCALIZATION_REASONING_EFFORT=low
MEDIAFORGE_OPENAI_LOCALIZATION_MAX_OUTPUT_TOKENS=10000
MEDIAFORGE_OPENAI_SHORT_MODEL=gpt-5.6-terra
MEDIAFORGE_OPENAI_SHORT_REASONING_EFFORT=low
MEDIAFORGE_OPENAI_SHORT_MAX_OUTPUT_TOKENS=4000
MEDIAFORGE_OPENAI_SHORT_REWRITE_RETRY_MAX_OUTPUT_TOKENS=4000
MEDIAFORGE_OPENAI_VALIDATOR_MODEL=gpt-5.4-mini
MEDIAFORGE_OPENAI_VALIDATOR_REASONING_EFFORT=low
MEDIAFORGE_OPENAI_VALIDATOR_MAX_OUTPUT_TOKENS=5000
MEDIAFORGE_OPENAI_METADATA_MODEL=gpt-5.4-mini
MEDIAFORGE_OPENAI_METADATA_REASONING_EFFORT=none
MEDIAFORGE_OPENAI_METADATA_MAX_OUTPUT_TOKENS=1800

# Two-phase image generation.
MEDIAFORGE_OPENAI_IMAGE_REFERENCE_MODEL=gpt-image-2
MEDIAFORGE_OPENAI_IMAGE_REFERENCE_QUALITY=high
MEDIAFORGE_OPENAI_IMAGE_REFERENCE_SIZE=1536x1024
MEDIAFORGE_OPENAI_IMAGE_SCENE_MODEL=gpt-image-2
MEDIAFORGE_OPENAI_IMAGE_SCENE_QUALITY=high
MEDIAFORGE_OPENAI_IMAGE_SCENE_SIZE=1920x1080
MEDIAFORGE_OPENAI_IMAGE_SHORT_MODEL=gpt-image-2
MEDIAFORGE_OPENAI_IMAGE_SHORT_QUALITY=high
MEDIAFORGE_OPENAI_IMAGE_SHORT_SIZE=1024x1536
MEDIAFORGE_OPENAI_IMAGE_VALIDATOR_MODEL=gpt-5.4-mini
MEDIAFORGE_OPENAI_IMAGE_VALIDATOR_REASONING_EFFORT=low
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1536x864
OPENAI_IMAGE_FULL_SIZE=1536x864
OPENAI_IMAGE_SHORT_SIZE=864x1536
YOUTUBE_FULL_RENDER_SIZE=1920x1080
YOUTUBE_SHORT_RENDER_SIZE=1080x1920
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_FORMAT=png
OPENAI_IMAGE_CONCURRENCY=1
OPENAI_IMAGE_MAX_RETRIES=2
OPENAI_IMAGE_TIMEOUT_MS=180000
OPENAI_THUMBNAIL_MODEL=gpt-image-2
OPENAI_THUMBNAIL_QUALITY=high
OPENAI_THUMBNAIL_TIMEOUT_MS=180000
OPENAI_THUMBNAIL_MAX_RETRIES=2
OPENAI_THUMBNAIL_MAX_PAYLOAD_BYTES=20971520
THUMBNAIL_DEFAULT_STYLE=viral-horror-v1
THUMBNAIL_FULL_REFERENCE=reference-thumbnails/thumbnail-full.png
THUMBNAIL_SHORT_REFERENCE=reference-thumbnails/thumbnail-short.png
THUMBNAIL_MAX_REFERENCE_BYTES=20971520
THUMBNAIL_MAX_GENERATED_BYTES=20971520
THUMBNAIL_TIMEOUT_MS=180000
THUMBNAIL_MAX_RETRIES=2
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_SPEECH_VOICE=onyx
OPENAI_METADATA_MODEL=gpt-4.1-mini
OPENAI_METADATA_MODEL_FALLBACKS=gpt-4o-mini
OPENAI_METADATA_MAX_RETRIES=3
OPENAI_METADATA_KEEP_FILE=false
OPENAI_METADATA_TIMEOUT_MS=120000
YOUTUBE_METADATA_LANGUAGE=en
MEDIAFORGE_WHISPER_BIN=./tools/whisper.cpp/build/bin/whisper-cli
MEDIAFORGE_WHISPER_MODEL=./tools/whisper.cpp/models/ggml-base.en.bin

EPISODES_SOURCE_ROOT=content-ideas/content/dark-truth-episodes-multilingual-production-pack
EPISODES_OUTPUT_ROOT=./episodes
OPENAI_ANALYSIS_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE_EN=
OPENAI_TTS_VOICE_DE=
OPENAI_TTS_VOICE_ES=
OPENAI_TTS_VOICE_FR=
OPENAI_TTS_FORMAT=wav
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_REQUEST_TIMEOUT_MS=180000
OPENAI_MAX_RETRIES=3

# History V3.3 low-cost semantic routing
# Trusted-script is the History default and does not require OPENAI_API_KEY.
# These vars apply only to explicit --live-research / research-backed mode
# (also requires --promote-to-research-backed against trusted-script episodes).
HISTORY_CLAIM_EXTRACTION_MODEL=gpt-5.6-luna
HISTORY_EVIDENCE_ASSESSMENT_MODEL=gpt-5.6-luna
HISTORY_RESEARCH_QUERY_MODEL=gpt-5.6-luna
HISTORY_VISUAL_SEMANTIC_MODEL=gpt-5.6-luna
HISTORY_ESCALATION_MODEL=gpt-5.6-terra

# Batch and caching
HISTORY_USE_BATCH_API=true
HISTORY_ENABLE_ESCALATION=true
HISTORY_REUSE_RETRIEVED_SOURCES=true
HISTORY_RESUME_COMPLETED_BATCHES=true
HISTORY_ENABLE_PROMPT_CACHING=true

# Search budgets
HISTORY_MAX_WEB_SEARCH_CALLS_PER_EPISODE=20
HISTORY_HARD_MAX_WEB_SEARCH_CALLS_PER_EPISODE=25
HISTORY_MAX_SEARCHES_PER_RESEARCH_CLUSTER=2
HISTORY_MAX_ALTERNATE_SOURCE_ATTEMPTS=2

# Batch/token limits
HISTORY_MAX_EVIDENCE_FRAGMENTS_PER_CLAIM=3
HISTORY_MAX_CLAIMS_PER_ASSESSMENT_BATCH=20
HISTORY_MAX_INPUT_TOKENS_PER_EXTRACTION_BATCH=12000
HISTORY_MAX_INPUT_TOKENS_PER_ASSESSMENT_BATCH=16000
HISTORY_MAX_OUTPUT_TOKENS_PER_EXTRACTION_BATCH=2500
HISTORY_MAX_OUTPUT_TOKENS_PER_ASSESSMENT_BATCH=1500

# Cost limits
HISTORY_SOFT_COST_BUDGET_USD_PER_EPISODE=1.25
HISTORY_HARD_COST_BUDGET_USD_PER_EPISODE=2.50
# Optional versioned pricing catalog JSON; when unset, cost estimate is unavailable
# HISTORY_PRICING_CATALOG_PATH=

# Provider reliability
HISTORY_OPENAI_TIMEOUT_MS=600000

DARK_TRUTH_ENABLE_PAID_PROVIDERS=false
TTS_CONCURRENCY=1
IMAGE_CONCURRENCY=1
SUBTITLE_FORMATS=srt,vtt
BURNED_IN_SUBTITLES=false
ENABLE_TRANSCRIPTION_QA=true
QA_SIMILARITY_THRESHOLD=0.98
MEDIAFORGE_TRAILING_SILENCE_RATIO=0.8
MEDIAFORGE_TRAILING_SILENCE_BUFFER_SECONDS=0.5
FULL_VIDEO_WIDTH=1920
FULL_VIDEO_HEIGHT=1080
SHORT_VIDEO_WIDTH=1080
SHORT_VIDEO_HEIGHT=1920

