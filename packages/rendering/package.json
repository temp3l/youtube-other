{
  "name": "@mediaforge/rendering",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./composition-contract.js": {
      "types": "./src/composition-contract.ts",
      "default": "./src/composition-contract.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mediaforge/domain": "workspace:*",
    "@mediaforge/process-runner": "workspace:*",
    "@mediaforge/shared": "workspace:*",
    "sharp": "^0.34.3",
    "zod": "^4.0.14"
  }
}
