{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": ".cache/tsconfig.tsbuildinfo"
