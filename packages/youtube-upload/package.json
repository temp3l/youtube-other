{
  "name": "@mediaforge/youtube-upload",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./multilingual-audio-capability": {
      "types": "./dist/multilingual-audio-capability.d.ts",
      "default": "./dist/multilingual-audio-capability.js"
    },
    "./publish-approval": {
      "types": "./dist/publish-approval.d.ts",
      "default": "./dist/publish-approval.js"
    },
    "./generic-media-publish": {
      "types": "./dist/generic-media-publish.d.ts",
      "default": "./dist/generic-media-publish.js"
    },
    "./strategic-publish-routing": {
      "types": "./dist/strategic-publish-routing.d.ts",
      "default": "./dist/strategic-publish-routing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mediaforge/config": "workspace:*",
    "@mediaforge/domain": "workspace:*",
    "@mediaforge/metadata": "workspace:*",
    "@mediaforge/observability": "workspace:*",
    "@mediaforge/shared": "workspace:*",
    "googleapis": "^173.0.0",
    "sharp": "^0.34.3",
    "zod": "^4.0.14"
  }
}
