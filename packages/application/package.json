{
  "name": "@mediaforge/application",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors.js": {
      "types": "./src/errors.ts",
      "default": "./src/errors.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mediaforge/config": "workspace:*",
    "@mediaforge/dark-truth": "workspace:*",
    "@mediaforge/domain": "workspace:*",
    "@mediaforge/history": "workspace:*",
    "@mediaforge/math-education": "workspace:*",
    "@mediaforge/strategic-reinvention": "workspace:*",
    "@mediaforge/workflow-engine": "workspace:*",
    "zod": "^4.0.14"
  }
}
