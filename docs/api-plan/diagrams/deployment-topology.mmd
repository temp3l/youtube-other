  customers[Customer endpoints]

  edge --> api
  api --> idp
  api --> db
  api --> obj
  sched --> db
  general --> db
  general --> obj
  general --> ai
  render --> db
  render --> obj
  publish --> db
  publish --> obj
  publish --> secrets
  publish --> yt
  hooks --> db
  hooks --> customers
