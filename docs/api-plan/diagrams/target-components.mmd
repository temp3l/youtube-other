    SCHED[Scheduler]
    WORKER[Worker handlers]
  end
  subgraph Application
    CMD[Command handlers]
    QUERY[Query handlers]
    POLICY[Authorization / quota]
  end
  subgraph Canonical
    ENGINE[Workflow operator]
    REGISTRY[Profile task registries]
